# Copy to .env and fill in. Never commit .env.

# Required for real answer generation. Without it the app still runs and
# retrieves, but answers are quoted straight from the retrieved chunk.
GROQ_API_KEY=

# Groq model used for generation and query rewriting.
GROQ_MODEL=llama-3.1-8b-instant

# Which generator to use: auto, groq, ollama, or none.
# auto picks Groq when GROQ_API_KEY is set, otherwise a local Ollama server.
LLM_PROVIDER=auto

# Local generation, no API key needed. Run `ollama list` to see what you have.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT=120

# How long a student waits for the generator before the answer is quoted from the
# retrieved text instead. The widget says when that happened.
GEN_TIMEOUT=30


# Protects every /api/admin/* route. Change this before exposing the app.
ADMIN_TOKEN=campusquery-demo

# Retrieval tuning
TOP_K_DENSE=20
TOP_K_BM25=20
TOP_N_CONTEXT=5
USE_RERANKER=1

# Ordering: blended score = RERANK_WEIGHT * sigmoid(cross-encoder) + (1-w) * normalised RRF.
# Pure cross-encoder ordering buries the right chunk on short colloquial questions.
RERANK_WEIGHT=0.6
# Refusal: raw cross-encoder logit of the best returned chunk. Picked with scripts/eval.py.
REFUSAL_THRESHOLD=-6.0

# Chunking
CHUNK_WORDS=300
CHUNK_OVERLAP_WORDS=45

# Where the corpus and the index live. Set these to run a second instance, or a test
# run, against its own data.
# DATA_DIR=data
# SEED_DIR=data/seed
# INDEX_DIR=data/index
# UPLOAD_DIR=data/uploads

# Scheduled refresh of the index: re-reads data/seed, re-fetches indexed URLs, drops
# documents whose seed file is gone and withdraws URLs that answer 404 or 410.
# Uploaded files are never wiped by it.
REINDEX_ENABLED=1
REINDEX_INTERVAL_HOURS=168
